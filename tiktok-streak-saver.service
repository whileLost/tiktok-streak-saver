[Unit]
Description=tiktok streak saver daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tiktok-streak-saver
ExecStart=/home/ubuntu/tiktok-streak-saver/venv/bin/python streak.py --daemon
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
